{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aicontext/check/v1",
  "title": "AIContext check result v1",
  "type": "object",
  "required": ["schema", "passed", "findings"],
  "properties": {
    "schema": { "const": "aicontext/check/v1" },
    "passed": { "type": "boolean" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "passed", "detail"],
        "properties": {
          "name": { "type": "string" },
          "passed": { "type": "boolean" },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
